generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  fullName      String
  bio           String   @default("")
  location      String   @default("New Delhi")
  avatarUrl     String   @default("")
  avatarTone    String   @default("sage")
  role          String   @default("MEMBER") // MEMBER | ADMIN
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions            Session[]
  interests           UserInterest[]
  organisedActivities Activity[]           @relation("ActivityOrganiser")
  participations      Participation[]
  communityMembers    CommunityMember[]
  conversationMembers ConversationMember[]
  messages            Message[]
  orders              Order[]
  tickets             Ticket[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Interest {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  icon  String @default("compass")

  users UserInterest[]
}

model UserInterest {
  userId     String
  interestId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

model Category {
  id          String @id @default(cuid())
  name        String @unique
  slug        String @unique
  description String @default("")
  icon        String @default("compass")
  tintColor   String @default("light-sage")
  sortOrder   Int    @default(0)

  activities  Activity[]
  communities Community[]
}

model Activity {
  id           String    @id @default(cuid())
  kind         String    @default("ACTIVITY") // ACTIVITY | EVENT
  title        String
  tagline      String    @default("")
  description  String
  activityType String    @default("IN_PERSON") // IN_PERSON | ONLINE
  date         DateTime
  startTime    String
  endDate      DateTime?
  endTime      String?
  durationMins Int?
  location     String
  venueName    String    @default("")
  fullAddress  String    @default("")
  neighborhood String    @default("Central Delhi")
  latitude     Float?
  longitude    Float?
  capacity     Int?
  imageUrl     String    @default("")
  tintColor    String    @default("light-sage")
  hostName     String    @default("")
  refundPolicy String    @default("")
  status       String    @default("ACTIVE") // ACTIVE | CANCELLED
  organiserId  String
  categoryId   String
  communityId  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organiser      User            @relation("ActivityOrganiser", fields: [organiserId], references: [id], onDelete: Cascade)
  category       Category        @relation(fields: [categoryId], references: [id])
  community      Community?      @relation(fields: [communityId], references: [id])
  participations Participation[]
  conversations  Conversation[]
  agendaItems    AgendaItem[]
  ticketTiers    TicketTier[]
  orders         Order[]
  tickets        Ticket[]
}

model AgendaItem {
  id          String @id @default(cuid())
  activityId  String
  time        String
  title       String
  description String @default("")
  sortOrder   Int    @default(0)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model TicketTier {
  id          String    @id @default(cuid())
  activityId  String
  name        String
  description String    @default("")
  priceInr    Int       @default(0)
  quantity    Int
  salesEndAt  DateTime?
  sortOrder   Int       @default(0)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  orders   Order[]
  tickets  Ticket[]
}

model Order {
  id             String   @id @default(cuid())
  orderNumber    String   @unique
  idempotencyKey String   @unique
  userId         String
  activityId     String
  tierId         String
  quantity       Int
  unitPriceInr   Int
  totalAmountInr Int
  paymentMethod  String   @default("FREE") // FREE | UPI | CARD | NETBANKING
  status         String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  tier     TicketTier @relation(fields: [tierId], references: [id])
  tickets  Ticket[]
}

model Ticket {
  id           String    @id @default(cuid())
  code         String    @unique
  activityId   String
  ownerId      String
  tierId       String
  orderId      String
  pricePaidInr Int       @default(0)
  status       String    @default("VALID") // VALID | USED | CANCELLED | REFUNDED
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  activity Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  owner    User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tier     TicketTier @relation(fields: [tierId], references: [id])
  order    Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Participation {
  id         String   @id @default(cuid())
  userId     String
  activityId String
  joinedAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
}

model Community {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String
  neighborhood String   @default("Delhi-NCR")
  tintColor    String   @default("sage")
  imageUrl     String   @default("")
  categoryId   String
  createdAt    DateTime @default(now())

  category   Category          @relation(fields: [categoryId], references: [id])
  members    CommunityMember[]
  activities Activity[]
}

model CommunityMember {
  userId      String
  communityId String
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([userId, communityId])
}

model Conversation {
  id         String   @id @default(cuid())
  type       String   @default("DIRECT") // ACTIVITY | DIRECT
  title      String?
  activityId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity Activity?            @relation(fields: [activityId], references: [id], onDelete: Cascade)
  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}
